{
    "name": "heimseiten/contao-space-bundle",
    "description": "Es können die Abstände von alten Contao Versionen zu Contao 5 übernommen werden. Vor und hinter Artikeln und Inhaltselementen und die Bildabstände.",
    "keywords": [
        "margin",
        "padding",
        "Abstände"
    ],
    "type": "contao-bundle",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "heimseiten.de - Webdesign aus Köln",
            "email": "info@heimseiten.de",
            "homepage": "https://www.heimseiten.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/heimseiten/contao-space-bundle/issues",
        "source": "https://github.com/heimseiten/contao-space-bundle"
    },
    "require": {
        "contao/core-bundle": "^4.9 || ^5.1"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Heimseiten\\ContaoSpaceBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Heimseiten\\ContaoSpaceBundle\\ContaoManager\\Plugin"
    }
}
